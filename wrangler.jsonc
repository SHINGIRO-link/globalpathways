{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "globalpathways",
  "compatibility_date": "2026-10-06",
  "observability": { "enabled": true },
  // Vite is built with base "/static/frontend/", so lay the assets out at that
  // path and keep index.html at the root for SPA routing.
  "build": {
    "command": "rm -rf dist/cf && mkdir -p dist/cf/static && cp -R dist/public dist/cf/static/frontend && cp dist/public/index.html dist/cf/index.html"
  },
  "assets": {
    "directory": "./dist/cf",
    "not_found_handling": "single-page-application"
  }
}
